            "pages": ["introduction", "why-leapfrog", "quickstart", "synthesis"]
          },
          {
            "group": "Basics",
            "pages": [
              "basics/workspaces",
              "basics/document-editor",
              "basics/transcribing-interviews",
              "basics/quotes-and-tags",
              "basics/auto-coding",
              "basics/canvas",
              "basics/chat",
              "basics/agent-skills",
              "basics/integrations",
              "basics/organizations"
            ]
          },
          {
            "group": "Desktop Shell",
            "pages": ["features/tray"]
          },
          {
            "group": "Advanced Features",
            "pages": ["analytics", "collaboration"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Product",
          "href": "https://dub.sh/qBduPB4",
          "icon": "right-to-bracket"
        },
        {
          "anchor": "Get a demo",
          "href": "https://dub.sh/2HwMxBP",
          "icon": "laptop"
        },
        {
          "anchor": "Community",
          "href": "https://leapfrogapp.slack.com/ssb/redirect#/shared-invite/email",
          "icon": "slack"
        },
        {
          "anchor": "Blog",
          "href": "https://leapfrogapp.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/logo.svg",
    "dark": "/logo/logo.svg",
    "href": "https://www.leapfrogapp.com/"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "variant": "secondary",
      "label": "Leapfrog",
      "href": "https://www.leapfrogapp.com/"
    }
  },
  "footer": {
    "socials": {
      "website": "https://www.leapfrogapp.com/",
      "slack": "https://leapfrogapp.slack.com/ssb/redirect#/shared-invite/email",
      "github": "https://github.com/Jkense/docs",
