{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Leapfrog Docs",
  "style": {
    "css": "style.css"
  },
  "colors": {
    "primary": "#22c55e",
    "light": "#07C983",
    "dark": "#0D9373"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "favicon": "/logo/logo-noname.svg",
